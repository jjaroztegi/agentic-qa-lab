    {
      "id": "9576ad77-b9bb-57c5-8010-7401c659c718",
      "name": "Next ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "\n// cases on main plus cases still open as PRs (branch case/cp-NNN), so two intakes never collide\nconst nums = [\n  ...$('Catalog cases').all().map((i) => /^CP-(\\d+)\\.yaml$/.exec(i.json.name ?? '')?.[1]),\n  ...$input.all().map((i) => /refs\\/heads\\/case\\/cp-(\\d+)$/.exec(i.json.ref ?? '')?.[1]),\n].filter(Boolean).map(Number);\nconst n = Math.max(0, ...nums) + 1;\nconst f = $('Case intake').first().json;\nreturn [{ json: { id: `CP-${String(n).padStart(3, '0')}`, form: f } }];\n"
      }
    },
