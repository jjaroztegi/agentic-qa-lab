    {
      "id": "eaac5f04-49f4-509f-a8b1-9890d2853f44",
      "name": "Draft case in the template",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        880,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ `Turn a key user's description into a test case in the single catalog template (YAML). Return ONLY the YAML, with no explanation and no code fences.\n\nRules:\n- id: ${$json.id}. Use exactly the keys of the example, in this order: id, title, process, subprocess, systems, priority, owner, frequency, preconditions, data, steps, expected_results, data_validation, dependencies. Write everything in English; keys inside data are snake_case English.\n- Expected results must be measurable (a value, a status, an exact message) and checkable without a person interpreting them.\n- If something is missing to make it measurable, do NOT invent it: write the field as \"PENDING: <what is missing>\" for the reviewer to complete.\n- The available systems are ERP (Odoo, standing in for SAP), MES (in-house application) and L2 (Java desktop client).\n- data_validation says how the result is checked in data (ERP mrp.production / sale.order, or the MES API /api/orders, /api/coils).\n\nExample case from the catalog:\n${$json.example}\n\nKey user's form:\nTitle: ${$json.form['Title']}\nProcess: ${$json.form['Process']}\nPriority: ${$json.form['Priority']}\nOwner: ${$json.form['Business owner']}\nFrequency: ${$json.form['Frequency']}\nDescription: ${$json.form['Describe the case']}\nHow it is checked: ${$json.form['How do you know it worked?'] ?? ''}` }}"
      }
    },
    {
      "id": "844e4467-cf0e-5725-a2c2-8f4eff53a355",
      "name": "Claude Sonnet 5.5",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
        880,
        220
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-sonnet-5-5"
        },
        "options": {
          "maxTokensToSample": 2000,
          "temperature": 0.2
        }
      },
      "credentials": {
        "anthropicApi": {
          "id": "qaAnthropic00001",
          "name": "Anthropic"
        }
      }
    },
    {
      "id": "4a69b3a3-267f-5c05-b0a1-f9557cecbdcf",
      "name": "Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "\nconst id = $('Next ID').first().json.id;\nlet yaml = $json.text.trim().replace(/^```(?:ya?ml)?\\s*/i, '').replace(/```\\s*$/, '').trim() + '\\n';\nif (!yaml.startsWith(`id: ${id}`) && !yaml.includes(`\\nid: ${id}`)) throw new Error('The generated YAML does not have the expected id ' + id);\nconst title = (yaml.match(/^title:\\s*(.+)$/m) ?? [, id])[1].replace(/^[\"']|[\"']$/g, '');\nconst pending = (yaml.match(/PENDING/g) ?? []).length;\nreturn [{ json: { id, title, yaml, branch: `case/${id.toLowerCase()}`, content: Buffer.from(yaml).toString('base64'), pending } }];\n"
      }
    },
